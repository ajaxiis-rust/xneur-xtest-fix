Depends: libc6 (>= 2.34), libglib2.0-0 (>= 2.66), libgtk2.0-0 (>= 2.24), libappindicator1 | libayatana-appindicator3-1, libnotify4, libenchant-2-2, libpcre3, libx11-6, libxi6, libxtst6
